---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../lib/url';
import { SITE, PHYSICS_PAGES, DOCS_PAGES, PROJECT_PAGES, REPO_PUBLIC } from '../lib/site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  /** Direct use from .astro pages. */
  title?: string;
  description?: string;
  nav?: NavKind;
  section?: string;
  /** Path of the social-card image under the site base. */
  ogImage?: string;
  headings?: Heading[];
  /** Injected by Astro when used as an MDX layout. */
  frontmatter?: {
    title: string;
    description?: string;
    nav?: NavKind;
    section?: string;
    ogImage?: string;
    file?: string;
  };
}

type NavKind = 'physics' | 'docs' | 'project';

const NAVS: Record<NavKind, { label: string; section: string; pages: { label: string; href: string }[] }> = {
  physics: { label: 'Physics & numerics', section: '/physics/', pages: PHYSICS_PAGES },
  docs: { label: 'Documentation', section: '/docs/', pages: DOCS_PAGES },
  project: { label: 'Project', section: '/about/', pages: PROJECT_PAGES },
};

const fm = Astro.props.frontmatter;
const title = fm?.title ?? Astro.props.title ?? SITE.name;
const description = fm?.description ?? Astro.props.description;
const ogImage = fm?.ogImage ?? Astro.props.ogImage;
const navKind = fm?.nav ?? Astro.props.nav ?? 'physics';
const nav = NAVS[navKind];
const section = fm?.section ?? Astro.props.section ?? nav.section;
const allHeadings = Astro.props.headings ?? [];
const headings = allHeadings.filter((h) => h.depth === 2 || h.depth === 3);
/**
 * Most pages in these sections open straight into an h2, which left them with
 * no h1 and no visible title at all. A page that writes its own `# Title`
 * keeps it; every other page gets its frontmatter title here.
 */
const needsTitle = !allHeadings.some((h) => h.depth === 1);

const pages = nav.pages;
const current = Astro.url.pathname.replace(/\/$/, '');
const index = pages.findIndex((p) => withBase(p.href).replace(/\/$/, '') === current);
const prev = index > 0 ? pages[index - 1] : undefined;
const next = index >= 0 && index < pages.length - 1 ? pages[index + 1] : undefined;

const file = fm?.file ?? '';
const repoPath = file.includes('/src/') ? `src/${file.split('/src/')[1]}` : undefined;
---

<BaseLayout title={title} description={description} section={section} ogImage={ogImage}>
  <div class="docs-grid">
    <nav class="side-nav" aria-label="Section">
      <div class="group">
        <span class="overline">{nav.label}</span>
        {
          pages.map((p) => (
            <a
              href={withBase(p.href)}
              aria-current={withBase(p.href).replace(/\/$/, '') === current ? 'page' : undefined}
            >
              {p.label}
            </a>
          ))
        }
      </div>
    </nav>

    <article class="prose docs-prose">
      {
        needsTitle && (
          <header class="docs-title">
            <span class="overline">{nav.label}</span>
            <h1>{title}</h1>
            {description && <p class="docs-lede">{description}</p>}
          </header>
        )
      }
      <slot />

      <div class="prev-next">
        {
          prev ? (
            <a href={withBase(prev.href)}>
              <span class="dir">← Previous</span>
              {prev.label}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={withBase(next.href)} style="text-align:right">
              <span class="dir">Next →</span>
              {next.label}
            </a>
          ) : (
            <span />
          )
        }
      </div>
      {
        REPO_PUBLIC && repoPath && (
          <p>
            <a class="edit-link" href={`${SITE.github}/edit/main/${repoPath}`} rel="noopener">
              Edit this page on GitHub
            </a>
          </p>
        )
      }
    </article>

    {
      headings.length > 1 && (
        <nav class="toc-rail" aria-label="On this page">
          <span class="overline">On this page</span>
          {headings.map((h) => (
            <a href={`#${h.slug}`} style={h.depth === 3 ? 'padding-left:1.5rem' : undefined}>
              {h.text}
            </a>
          ))}
        </nav>
      )
    }
  </div>
</BaseLayout>

<script>
  // Scroll-tracking table of contents.
  const toc = document.querySelector('.toc-rail');
  if (toc) {
    const links = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
      links.set(decodeURIComponent(a.hash.slice(1)), a);
    });
    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);
    let active: HTMLAnchorElement | undefined;
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const link = links.get(entry.target.id);
            if (link && link !== active) {
              active?.removeAttribute('data-active');
              link.setAttribute('data-active', '');
              active = link;
            }
          }
        }
      },
      { rootMargin: '-15% 0px -70% 0px' }
    );
    targets.forEach((t) => io.observe(t));
  }
</script>
