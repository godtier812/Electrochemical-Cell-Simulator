---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Not found" description="This page does not exist." noIndex>
  <div class="page">
    <div class="prose">
      <h1>Not found</h1>
      <p>
        This page does not resolve. Like an unconverged Newton step, the best
        move is to go back to a good iterate.
      </p>
      <ul>
        <li><a href={withBase('/')}>Home</a></li>
        <li><a href={withBase('/physics/')}>Physics</a></li>
        <li><a href={withBase('/demos/')}>Demos</a></li>
        <li><a href={withBase('/validation/')}>Validation</a></li>
      </ul>
    </div>
  </div>
</BaseLayout>
