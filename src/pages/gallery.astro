---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { SITE } from '../lib/site';

interface Figure {
  src: string;
  alt: string;
  title: string;
  caption: string;
}

const figures: Figure[] = [
  {
    src: 'gallery/dendrite-t1.png',
    title: 'Electrodeposition, t₁',
    alt: 'Early stage of phase-field electrodeposition: small metal bumps forming on a flat electrode',
    caption: 'Phase-field ξ at 1 500 steps: five nuclei on a flat electrode, aη = −6, δ = 0.06, ω = 4.',
  },
  {
    src: 'gallery/dendrite-t2.png',
    title: 'Electrodeposition, t₂',
    alt: 'Needles beginning to race ahead of the deposit front',
    caption: 'The same run at 2 500 steps: needles emerge where the depletion field lets them.',
  },
  {
    src: 'gallery/dendrite-t3.png',
    title: 'Electrodeposition, t₃',
    alt: 'A forest of competing needles at mid growth',
    caption: '3 500 steps: tip competition. Needles that fall behind sit in their neighbours’ depletion zones and stall.',
  },
  {
    src: 'gallery/dendrite-t4.png',
    title: 'Electrodeposition, t₄',
    alt: 'Mature dendrite forest spanning most of the domain',
    caption: '5 000 steps: the surviving arms span the cell — the short-circuit failure mode in metal batteries.',
  },
  {
    src: 'gallery/dendrite-concentration.png',
    title: 'Ion depletion field',
    alt: 'Concentration field around the dendrites: dark depleted zones hug the metal front',
    caption: 'C/C₀ (inferno ramp) for the frame above: growth is diffusion-limited — the front lives at the edge of its own depletion zone.',
  },
  {
    src: 'gallery/dendrite-6fold.png',
    title: 'Six-fold anisotropy',
    alt: 'Deposit grown with six-fold crystalline anisotropy showing different branch angles',
    caption: 'Same model, ω = 6, δ = 0.025: the anisotropy mode alone changes the branch geometry.',
  },
  {
    src: 'gallery/needles.png',
    title: 'Needle regime',
    alt: 'Three smooth needles growing in parallel with no side branching',
    caption: 'Low drive (L_η = 0.05, gentler noise): smooth stable needles — the mossy-to-dendritic transition’s midpoint.',
  },
  {
    src: 'gallery/microstructure-eps45.png',
    title: 'Porous electrode, ε ≈ 0.45',
    alt: 'Dense particle packing with the transport field squeezing through narrow pores',
    caption: 'RSA packing at low porosity; the Laplace field (viridis) funnels through the few percolating channels.',
  },
  {
    src: 'gallery/microstructure-eps60.png',
    title: 'Porous electrode, ε ≈ 0.60',
    alt: 'Medium-density particle packing with more open transport paths',
    caption: 'Moderate porosity: shorter, straighter paths; measured tortuosity approaches Bruggeman.',
  },
  {
    src: 'gallery/microstructure-eps75.png',
    title: 'Porous electrode, ε ≈ 0.75',
    alt: 'Sparse particle packing with nearly uniform transport field',
    caption: 'Open structure: the field is nearly uniform and D_eff/D₀ approaches the porosity itself.',
  },
  {
    src: 'gallery/drt-ageing.svg',
    title: 'DRT vs SEI age',
    alt: 'Distribution of relaxation times for three cell ages, with a growing second peak',
    caption: 'Tikhonov-NNLS DRT of the demo circuit at three SEI ages: the film peak grows and separates from charge transfer.',
  },
];
---

<BaseLayout
  title="Gallery"
  description="Figures generated by the same TypeScript physics code that powers the live demos: dendrite growth series, depletion fields, porous microstructures, and DRT ageing."
  section="/gallery/"
  ogImage="posters/og-gallery.png"
>
  <div class="page">
    <article class="prose">
      <span class="overline">Figures</span>
      <h1>Gallery</h1>
      <p>
        Every image below was generated at build time by the same TypeScript code that runs the
        live demos, by a seeded generator script so the output is reproducible. Nothing here is
        an artist’s impression; captions state the model and parameters.
      </p>
      <p class="figure-licence">
        These figures are output of the MIT-licensed generator and carry the same terms: use,
        modify and redistribute them, including in talks and papers, provided the copyright and
        licence notice travel with them. Attribution as “Voltaire, {SITE.author}” is welcome
        but not required. Full terms on the <a href={withBase('/cite/')}>cite page</a>.
      </p>
    </article>

    <div class="gallery-grid">
      {
        figures.map((fig, i) => (
          <figure class="gallery-card">
            <button
              class="gallery-open"
              type="button"
              data-index={i}
              aria-label={`Enlarge: ${fig.title}`}
            >
              <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
            </button>
            <figcaption>
              <strong>{fig.title}</strong> — {fig.caption}
              <a class="gallery-download" href={withBase(fig.src)} download>
                download full size
              </a>
            </figcaption>
          </figure>
        ))
      }
    </div>

    <dialog class="lightbox" aria-label="Figure viewer">
      <div class="lightbox-bar">
        <span class="lightbox-count" role="status"></span>
        <a class="lightbox-download" href="" download>download</a>
        <button class="lightbox-close" type="button" aria-label="Close viewer">esc</button>
      </div>
      <img class="lightbox-img" src="" alt="" />
      <p class="lightbox-caption"></p>
      <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous figure">‹</button>
      <button class="lightbox-nav lightbox-next" type="button" aria-label="Next figure">›</button>
    </dialog>

    <script is:inline define:vars={{ figures: figures.map((f) => ({ ...f, src: withBase(f.src) })) }}>
      (() => {
        const dialog = document.querySelector('.lightbox');
        if (!dialog || !figures.length) return;
        const img = dialog.querySelector('.lightbox-img');
        const cap = dialog.querySelector('.lightbox-caption');
        const count = dialog.querySelector('.lightbox-count');
        const dl = dialog.querySelector('.lightbox-download');
        let at = 0;

        const show = (i) => {
          at = (i + figures.length) % figures.length;
          const f = figures[at];
          img.src = f.src;
          img.alt = f.alt;
          cap.textContent = `${f.title} — ${f.caption}`;
          count.textContent = `${at + 1} / ${figures.length}`;
          dl.href = f.src;
        };

        document.querySelectorAll('.gallery-open').forEach((btn) => {
          btn.addEventListener('click', () => {
            show(Number(btn.dataset.index));
            dialog.showModal();
          });
        });

        dialog.querySelector('.lightbox-close').addEventListener('click', () => dialog.close());
        dialog.querySelector('.lightbox-prev').addEventListener('click', () => show(at - 1));
        dialog.querySelector('.lightbox-next').addEventListener('click', () => show(at + 1));
        // Escape is handled natively by <dialog>; add the arrows.
        dialog.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            show(at - 1);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            show(at + 1);
          }
        });
        // Clicking the backdrop (the dialog itself) dismisses.
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });
      })();
    </script>
  </div>
</BaseLayout>

<style>
  .figure-licence {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    border-left: 2px solid var(--line-strong);
    padding-left: var(--s3);
  }

  .gallery-grid {
    display: grid;
    gap: var(--s5);
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    margin-top: var(--s6);
  }

  .gallery-card {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    overflow: hidden;
    background: var(--surface);
  }

  .gallery-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .gallery-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .gallery-card img {
    width: 100%;
    aspect-ratio: 2/1;
    object-fit: cover;
    image-rendering: auto;
    display: block;
  }

  .gallery-card figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    padding: var(--s3);
    line-height: 1.5;
  }

  .gallery-download {
    display: block;
    margin-top: var(--s2);
    color: var(--accent);
  }

  /* ---------- lightbox ---------- */

  .lightbox {
    width: min(1100px, calc(100vw - 2rem));
    max-width: none;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-panel);
    background: var(--surface);
    color: var(--fg);
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: var(--s3) var(--s4);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .lightbox-count {
    flex: 1;
    font-variant-numeric: tabular-nums;
  }

  .lightbox-download {
    color: var(--accent);
  }

  .lightbox-close {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: var(--s1) var(--s2);
    cursor: pointer;
  }

  /* The card crops to 2/1; here the figure is shown whole. */
  .lightbox-img {
    display: block;
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    background: var(--surface-2);
  }

  .lightbox-caption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    line-height: 1.5;
    margin: 0;
    padding: var(--s3) var(--s4);
  }

  /* Kept inside the dialog at every width: hanging them outside clips against
     the viewport as soon as the dialog reaches its max width. */
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    width: 2.2rem;
    height: 2.2rem;
    cursor: pointer;
    opacity: 0.85;
  }

  .lightbox-nav:hover,
  .lightbox-nav:focus-visible {
    opacity: 1;
  }

  .lightbox-prev {
    left: var(--s3);
  }

  .lightbox-next {
    right: var(--s3);
  }
</style>
