---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
import { SITE } from '../lib/site';

interface Figure {
  src: string;
  alt: string;
  title: string;
  caption: string;
  /** A live counterpart, and whether it reproduces this exact figure. */
  live?: { href: string; text: string };
}

interface Series {
  id: string;
  title: string;
  intro: string;
  /** Columns at full width; every image in a series shares an aspect ratio. */
  cols: 1 | 2 | 3 | 4;
  aspect: string;
  figures: Figure[];
}

const series: Series[] = [
  {
    id: 'deposition',
    title: 'One electrodeposition run',
    intro:
      'Four frames of a single phase-field run, from five nuclei on a flat electrode to a forest that spans the cell. Same seed, same parameters throughout.',
    cols: 2,
    aspect: '2 / 1',
    figures: [
      {
        src: 'gallery/dendrite-t1.png',
        title: '1 500 steps',
        alt: 'Early stage of phase-field electrodeposition: small metal bumps forming on a flat electrode',
        caption: 'Phase field ξ: five nuclei on a flat electrode, aη = −6, δ = 0.06, ω = 4.',
      },
      {
        src: 'gallery/dendrite-t2.png',
        title: '2 500 steps',
        alt: 'Needles beginning to race ahead of the deposit front',
        caption: 'Needles emerge where the depletion field lets them.',
      },
      {
        src: 'gallery/dendrite-t3.png',
        title: '3 500 steps',
        alt: 'A forest of competing needles at mid growth',
        caption: 'Tip competition: needles that fall behind sit in their neighbours’ depletion zones and stall.',
      },
      {
        src: 'gallery/dendrite-t4.png',
        title: '5 000 steps',
        alt: 'Mature dendrite forest spanning most of the domain',
        caption: 'The surviving arms span the cell — the short-circuit failure mode in metal batteries.',
      },
    ],
  },
  {
    id: 'instant',
    title: 'Metal and electrolyte at one instant',
    intro:
      'The same run at 4 400 steps, drawn twice: the deposit, and the ion concentration around it. Growth is diffusion-limited, so the front lives at the edge of its own depletion zone.',
    cols: 2,
    aspect: '2 / 1',
    figures: [
      {
        src: 'posters/hero.png',
        title: 'Deposit, 4 400 steps',
        alt: 'A mature forest of metal dendrites, the frame the landing page opens on',
        caption: 'Phase field ξ: metal in yellow and green, electrolyte in purple. This is also the landing page’s opening frame.',
      },
      {
        src: 'gallery/dendrite-concentration.png',
        title: 'Ion depletion, 4 400 steps',
        alt: 'Concentration field around the dendrites: dark depleted zones hug the metal front',
        caption: 'C/C₀ on the inferno ramp. The dark pockets between branches are electrolyte the growth has already spent.',
        live: { href: '/demos/?d3-showc=1#demo-dendrite', text: 'concentration view, live' },
      },
    ],
  },
  {
    id: 'morphology',
    title: 'Morphology',
    intro: 'The same model with one setting changed, to show what each one controls.',
    cols: 2,
    aspect: '9 / 5',
    figures: [
      {
        src: 'gallery/dendrite-6fold.png',
        title: 'Six-fold anisotropy',
        alt: 'Deposit grown with six-fold crystalline anisotropy showing different branch angles',
        caption: 'ω = 6, δ = 0.025: the anisotropy mode alone changes the branch geometry.',
        live: { href: '/demos/?d3-omega=6&d3-delta=0.025#demo-dendrite', text: 'six-fold, live' },
      },
      {
        src: 'gallery/needles.png',
        title: 'Needle regime',
        alt: 'Three smooth needles growing in parallel with no side branching',
        caption: 'Low drive (L_η = 0.05, gentler noise): smooth stable needles, the midpoint of the mossy-to-dendritic transition.',
      },
    ],
  },
  {
    id: 'porous',
    title: 'Porous electrodes',
    intro:
      'Random particle packings at three porosities, with the steady diffusion field solved through the pores. Each one reopens in the microstructure demo as exactly this packing, with its measured D_eff/D₀ computed live.',
    cols: 3,
    aspect: '8 / 5',
    figures: [
      {
        src: 'gallery/microstructure-eps45.png',
        title: 'ε ≈ 0.45',
        alt: 'Dense particle packing with the transport field squeezing through narrow pores',
        caption: 'Low porosity: the field funnels through the few percolating channels.',
        live: { href: '/demos/?d5-eps=0.45&d5-seed=31#demo-microstructure', text: 'this packing, live' },
      },
      {
        src: 'gallery/microstructure-eps60.png',
        title: 'ε ≈ 0.60',
        alt: 'Medium-density particle packing with more open transport paths',
        caption: 'Shorter, straighter paths; the measured tortuosity falls.',
        live: { href: '/demos/?d5-eps=0.6&d5-seed=32#demo-microstructure', text: 'this packing, live' },
      },
      {
        src: 'gallery/microstructure-eps75.png',
        title: 'ε ≈ 0.75',
        alt: 'Sparse particle packing with nearly uniform transport field',
        caption: 'Open structure: the field is nearly uniform and D_eff/D₀ approaches the porosity itself.',
        live: { href: '/demos/?d5-eps=0.75&d5-seed=33#demo-microstructure', text: 'this packing, live' },
      },
    ],
  },
  {
    id: 'impedance',
    title: 'Impedance',
    intro: 'The impedance demo’s circuit, inverted to a distribution of relaxation times at three ages of its SEI film.',
    cols: 1,
    aspect: '9 / 5',
    figures: [
      {
        src: 'gallery/drt-ageing.svg',
        title: 'DRT against SEI age',
        alt: 'Distribution of relaxation times for three cell ages, with a growing second peak',
        caption:
          'Tikhonov-NNLS DRT for a fresh cell, and at 1× and 2.5× film resistance: the film peak grows and separates from charge transfer.',
        live: { href: '/demos/?d4-age=250#demo-impedance', text: 'the same circuit at 2.5×, live' },
      },
    ],
  },
];

const figures = series.flatMap((s) => s.figures);
---

<BaseLayout
  title="Gallery"
  description="Figures generated by the same TypeScript physics code that powers the live demos: dendrite growth series, depletion fields, porous microstructures, and DRT ageing."
  section="/gallery/"
  ogImage="posters/og-gallery.png"
>
  <div class="page">
    <article class="prose">
      <span class="overline">Figures</span>
      <h1>Gallery</h1>
      <p>
        Every image below was generated at build time by the same TypeScript code that runs the
        live demos, by a seeded generator script so the output is reproducible. Nothing here is
        an artist’s impression; captions state the model and parameters. The porous-electrode
        figures reopen in their demo as exactly the packing shown. The dendrite runs were made
        with settings the demo's controls do not reach, so their links open the nearest live
        view rather than claiming to reproduce them.
      </p>
      <p class="figure-licence">
        These figures are output of the MIT-licensed generator and carry the same terms: use,
        modify and redistribute them, including in talks and papers, provided the copyright and
        licence notice travel with them. Attribution as “Voltaire, {SITE.author}” is welcome
        but not required. Full terms on the <a href={withBase('/cite/')}>cite page</a>.
      </p>
    </article>

    {
      series.map((ser) => (
        <section class="gallery-series" id={ser.id} aria-labelledby={`${ser.id}-h`}>
          <h2 id={`${ser.id}-h`}>{ser.title}</h2>
          <p class="gallery-intro">{ser.intro}</p>
          <div class={`gallery-grid cols-${ser.cols}`} style={`--fig-aspect: ${ser.aspect}`}>
            {ser.figures.map((fig) => {
              const i = figures.indexOf(fig);
              return (
                <figure class="gallery-card">
                  <button class="gallery-open" type="button" data-index={i} aria-label={`Enlarge: ${fig.title}`}>
                    <img src={withBase(fig.src)} alt={fig.alt} loading="lazy" decoding="async" />
                  </button>
                  <figcaption>
                    <strong>{fig.title}</strong> — {fig.caption}
                    <span class="gallery-links">
                      {fig.live && <a href={withBase(fig.live.href)}>{fig.live.text} →</a>}
                      <a class="gallery-download" href={withBase(fig.src)} download>
                        download
                      </a>
                    </span>
                  </figcaption>
                </figure>
              );
            })}
          </div>
        </section>
      ))
    }

    <dialog class="lightbox" aria-label="Figure viewer">
      <div class="lightbox-bar">
        <span class="lightbox-count" role="status"></span>
        <a class="lightbox-download" href="" download>download</a>
        <button class="lightbox-close" type="button" aria-label="Close viewer">esc</button>
      </div>
      <img class="lightbox-img" src="" alt="" />
      <p class="lightbox-caption"></p>
      <button class="lightbox-nav lightbox-prev" type="button" aria-label="Previous figure">‹</button>
      <button class="lightbox-nav lightbox-next" type="button" aria-label="Next figure">›</button>
    </dialog>

    <script is:inline define:vars={{ figures: figures.map((f) => ({ ...f, src: withBase(f.src) })) }}>
      (() => {
        const dialog = document.querySelector('.lightbox');
        if (!dialog || !figures.length) return;
        const img = dialog.querySelector('.lightbox-img');
        const cap = dialog.querySelector('.lightbox-caption');
        const count = dialog.querySelector('.lightbox-count');
        const dl = dialog.querySelector('.lightbox-download');
        let at = 0;

        const show = (i) => {
          at = (i + figures.length) % figures.length;
          const f = figures[at];
          img.src = f.src;
          img.alt = f.alt;
          cap.textContent = `${f.title} — ${f.caption}`;
          count.textContent = `${at + 1} / ${figures.length}`;
          dl.href = f.src;
        };

        document.querySelectorAll('.gallery-open').forEach((btn) => {
          btn.addEventListener('click', () => {
            show(Number(btn.dataset.index));
            dialog.showModal();
          });
        });

        dialog.querySelector('.lightbox-close').addEventListener('click', () => dialog.close());
        dialog.querySelector('.lightbox-prev').addEventListener('click', () => show(at - 1));
        dialog.querySelector('.lightbox-next').addEventListener('click', () => show(at + 1));
        // Escape is handled natively by <dialog>; add the arrows.
        dialog.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowLeft') {
            e.preventDefault();
            show(at - 1);
          } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            show(at + 1);
          }
        });
        // Clicking the backdrop (the dialog itself) dismisses.
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });
      })();
    </script>
  </div>
</BaseLayout>

<style>
  .figure-licence {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--fg-muted);
    border-left: 2px solid var(--line-strong);
    padding-left: var(--s3);
  }

  .gallery-series {
    margin-top: var(--s7);
    scroll-margin-top: 5rem;
  }

  .gallery-series h2 {
    margin-bottom: var(--s2);
  }

  .gallery-intro {
    max-width: var(--measure);
    color: var(--fg-muted);
    margin-bottom: var(--s4);
  }

  /* Every image in a series has the same shape, so each grid shows them
     whole instead of cropping them all to one ratio. */
  .gallery-grid {
    display: grid;
    gap: var(--s4);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .gallery-grid.cols-2,
    .gallery-grid.cols-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .gallery-grid.cols-1 {
      max-width: 52rem;
    }
  }

  @media (min-width: 1000px) {
    .gallery-grid.cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .gallery-card {
    margin: 0;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    overflow: hidden;
    background: var(--surface);
    transition: border-color 0.15s ease;
  }

  .gallery-card:hover {
    border-color: var(--line-strong);
  }

  .gallery-open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .gallery-open:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -3px;
  }

  .gallery-card img {
    width: 100%;
    aspect-ratio: var(--fig-aspect);
    object-fit: contain;
    display: block;
    transition: transform 0.3s ease;
  }

  .gallery-open:hover img {
    transform: scale(1.015);
  }

  .gallery-card figcaption {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    padding: var(--s3);
    line-height: 1.5;
    border-top: 1px solid var(--line);
  }

  .gallery-card figcaption strong {
    color: var(--fg);
  }

  .gallery-links {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1) var(--s4);
  }

  .gallery-links a {
    color: var(--accent);
  }

  /* ---------- lightbox ---------- */

  .lightbox {
    width: min(1100px, calc(100vw - 2rem));
    max-width: none;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-panel);
    background: var(--surface);
    color: var(--fg);
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    gap: var(--s3);
    padding: var(--s3) var(--s4);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
  }

  .lightbox-count {
    flex: 1;
    font-variant-numeric: tabular-nums;
  }

  .lightbox-download {
    color: var(--accent);
  }

  .lightbox-close {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted);
    background: none;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: var(--s1) var(--s2);
    cursor: pointer;
  }

  /* The card crops to 2/1; here the figure is shown whole. */
  .lightbox-img {
    display: block;
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
    background: var(--surface-2);
  }

  .lightbox-caption {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    line-height: 1.5;
    margin: 0;
    padding: var(--s3) var(--s4);
  }

  /* Kept inside the dialog at every width: hanging them outside clips against
     the viewport as soon as the dialog reaches its max width. */
  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    width: 2.2rem;
    height: 2.2rem;
    cursor: pointer;
    opacity: 0.85;
  }

  .lightbox-nav:hover,
  .lightbox-nav:focus-visible {
    opacity: 1;
  }

  .lightbox-prev {
    left: var(--s3);
  }

  .lightbox-next {
    right: var(--s3);
  }
</style>
