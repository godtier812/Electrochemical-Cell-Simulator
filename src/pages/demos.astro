---
import BaseLayout from '../layouts/BaseLayout.astro';
import D1ButlerVolmer from '../components/demos/D1ButlerVolmer.astro';
import D2DoubleLayer from '../components/demos/D2DoubleLayer.astro';
import D3Dendrite from '../components/demos/D3Dendrite.astro';
import D4Impedance from '../components/demos/D4Impedance.astro';
import D5Microstructure from '../components/demos/D5Microstructure.astro';
import D6Discharge from '../components/demos/D6Discharge.astro';
import { withBase } from '../lib/url';
import { DEMO_COUNT } from '../lib/demos';
import DemoIndex from '../components/DemoIndex.astro';
---

<BaseLayout
  title="Demos"
  description="Interactive demos computing the real numerics in your browser: Butler–Volmer kinetics, the PNP double layer, phase-field dendrites, impedance with live DRT inversion, microstructure tortuosity, and a single-particle discharge curve."
  section="/demos/"
  ogImage="posters/og-demos.png"
>
  <div class="page">
    <article class="prose">
      <span class="overline">Live</span>
      <h1>Demos</h1>
      <p>
        {DEMO_COUNT} models, computed in this tab while you drag the sliders. No server is
        involved and nothing is a prerendered frame. Each one has presets worth trying under the
        plot, a write-up of its model and assumptions, and a toolbar to hold a curve for
        comparison, export what is plotted, or copy a link that reopens it exactly as it is.
      </p>
      <p>
        The physics is written up in the <a href={withBase('/physics/')}>physics section</a>, and
        the checks against analytic solutions are on the
        <a href={withBase('/validation/')}>validation page</a>. If JavaScript is off, each demo
        shows a frame precomputed by the same code.
      </p>
    </article>

    <div class="demo-jump">
      <DemoIndex variant="chips" base="" />
    </div>

    <div class="demo-list">
      <D1ButlerVolmer />
      <D2DoubleLayer />
      <D3Dendrite />
      <D4Impedance />
      <D5Microstructure />
      <D6Discharge />
    </div>
  </div>
</BaseLayout>

<style>
  .demo-list {
    display: flex;
    flex-direction: column;
    gap: var(--s7);
    margin-top: var(--s6);
  }

  .demo-list > :global(.demo) {
    scroll-margin-top: 8rem;
    margin: 0;
  }

  /* The page is six tall figures; the index stays in reach under the header. */
  .demo-jump {
    position: sticky;
    top: 3.3rem;
    z-index: 20;
    margin: var(--s5) calc(-1 * var(--s4)) 0;
    padding: var(--s2) var(--s4);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .demo-jump::-webkit-scrollbar {
    display: none;
  }

  .demo-jump :global(.demo-chips) {
    flex-wrap: nowrap;
  }
</style>
