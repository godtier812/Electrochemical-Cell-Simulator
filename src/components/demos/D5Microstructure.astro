---
import DemoShell from '../DemoShell.astro';
---

<DemoShell
  id="demo-microstructure"
  title="D5 · Microstructure & tortuosity"
  poster="d5-microstructure.png"
  alt="A stochastic packing of dark circular particles with the transport potential shown in colour through the pore space between them"
  aspect="8/5"
  caption="A porous electrode generated by random sequential adsorption, with the steady Laplace field solved through the pore phase (conjugate gradient on the masked 5-point stencil) and a few streamlines traced through it. The measured D_eff/D₀ comes from the computed flux; compare it with the Bruggeman correction ε^1.5, which assumes ideal spherical packing and drifts from the measured value as porosity falls or particles overlap into necks."
>
  <fieldset class="panel" slot="panel" disabled>
    <legend>microstructure generator</legend>
    <div class="control-row">
      <label for="d5-eps">target porosity ε</label>
      <input type="range" id="d5-eps" min="35" max="90" step="1" value="55" />
      <output class="readout" id="d5-eps-out" for="d5-eps">0.55</output>
    </div>
    <div class="control-row">
      <label for="d5-r">particle radius</label>
      <input type="range" id="d5-r" min="4" max="14" step="1" value="8" />
      <output class="readout" id="d5-r-out" for="d5-r">8 px</output>
    </div>
    <div class="control-row">
      <label for="d5-s">polydispersity</label>
      <input type="range" id="d5-s" min="0" max="50" step="5" value="25" />
      <output class="readout" id="d5-s-out" for="d5-s">±25%</output>
    </div>
    <div class="switch-row">
      <label><input type="checkbox" id="d5-lines" checked /> streamlines</label>
      <button class="copy-btn" type="button" id="d5-reseed">new packing</button>
    </div>
    <div class="panel-readouts">
      <span>ε measured <output id="d5-meas-eps">—</output></span>
      <span>D_eff/D₀ measured <output id="d5-deff">—</output></span>
      <span>Bruggeman ε^1.5 <output id="d5-brugg">—</output></span>
      <span>τ measured <output id="d5-tort">—</output></span>
      <span>τ Bruggeman ε^-0.5 <output id="d5-tort-brugg">—</output></span>
    </div>
  </fieldset>
</DemoShell>

<script>
  import { initWhenVisible } from './runtime';
  initWhenVisible('demo-microstructure', async (shell) => {
    const { init } = await import('./d5-microstructure');
    init(shell);
  });
</script>
