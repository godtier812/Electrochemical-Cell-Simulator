---
import DemoShell from '../DemoShell.astro';
import Control from './Control.astro';
---

<DemoShell
  id="demo-microstructure"
  title="D5 · Microstructure & tortuosity"
  poster="d5-microstructure.png"
  alt="A stochastic packing of dark circular particles with the transport potential shown in colour through the pore space between them"
  aspect="8/5"
  caption="A porous electrode generated by random sequential adsorption, with the steady Laplace field solved through the pore phase (conjugate gradient on a 5-point stencil weighted by how open each face is) and a few streamlines traced through it. Particle boundaries are sampled eight times per axis rather than rounded to whole cells, which keeps the discretisation error under 2% instead of the 28% that whole-cell rounding cost at low porosity. The measured D_eff/D₀ comes from the computed flux, and is shown against two references. ε/(2−ε) is the 2D result for insulating circular inclusions — equivalently (1−f)/(1+f) with f = 1−ε the solid fraction, the same expression written the other way — and it is an upper bound, so the measurement must sit below it. ε^1.5 is the Bruggeman correction: a 3D-spheres correlation, shown because it is what practitioners reach for, and above ε ≈ 0.382 it exceeds what any 2D geometry can achieve. Insertion rejects overlaps, so disks crowd towards tangency and transport is throttled by the narrow necks between them as porosity falls."
>
  <fieldset class="panel" slot="panel" disabled>
    <legend>microstructure generator</legend>
    <Control id="d5-eps" label="target porosity ε" min={0.35} max={0.9} value={0.55} step={0.01} />
    <Control id="d5-r" label="particle radius / px" min={4} max={14} value={8} step={1} />
    <Control id="d5-s" label="polydispersity / ±%" min={0} max={50} value={25} step={5} />
    <div class="switch-row">
      <label><input type="checkbox" id="d5-lines" checked /> streamlines</label>
      <button class="copy-btn" type="button" id="d5-reseed">new packing</button>
    </div>
    <div class="panel-readouts is-grouped">
      <div class="readout-row" id="d5-row-measured">
        <span class="readout-label">measured</span>
        <span>D_eff/D₀ <output id="d5-deff">—</output></span>
        <span>τ <output id="d5-tort">—</output></span>
      </div>
      <div class="readout-row" id="d5-row-reference">
        <span class="readout-label">reference</span>
        <span>2D bound ε/(2−ε) <output id="d5-maxwell">—</output></span>
        <span>Bruggeman ε^1.5 <output id="d5-brugg">—</output></span>
        <span>τ Bruggeman ε^-0.5 <output id="d5-tort-brugg">—</output></span>
      </div>
      <div class="readout-row" id="d5-row-structure">
        <span class="readout-label">structure</span>
        <span>ε measured <output id="d5-meas-eps">—</output></span>
        <span id="d5-sat-note" hidden>RSA jamming limit <output id="d5-sat">—</output></span>
      </div>
    </div>
  </fieldset>
</DemoShell>

<script>
  import { initWhenVisible } from './runtime';
  initWhenVisible('demo-microstructure', async (shell) => {
    const { init } = await import('./d5-microstructure');
    init(shell);
  });
</script>
