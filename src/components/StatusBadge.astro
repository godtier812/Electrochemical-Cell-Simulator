---
type Status = 'shipped' | 'in-progress' | 'planned' | 'research';

interface Props {
  status: Status;
  /** Override the visible label, e.g. "browser demo". */
  label?: string;
}

const { status, label } = Astro.props;

const defaultLabels: Record<Status, string> = {
  shipped: 'shipped',
  'in-progress': 'in progress',
  planned: 'planned',
  research: 'research',
};
---

<span class={`badge badge-${status}`}>{label ?? defaultLabels[status]}</span>
